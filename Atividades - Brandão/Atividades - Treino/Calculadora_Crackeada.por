programa {
  funcao inicio() {
    inteiro n1,n2

    escreva("insira o primeiro numero pra somar : ")
    leia(n1)

    escreva("\ninsira o segundo numero pra somar : ")
    leia(n2)

    inteiro resultado_da_soma,resultado_da_subtracao,resultado_da_divisisao, resultado_da_multiplicacao

    resultado_da_soma = n1 + n2
    escreva("\nresultado da soma : " , resultado_da_soma)

    resultado_da_subtracao = n1 - n2
    escreva("\nresultado da sutrção : " , resultado_da_subtracao)

    resultado_da_divisisao = n1 / n2
    escreva("\nresultado da divisão : " , resultado_da_divisisao)

    resultado_da_multiplicacao = n1 * n2
    escreva("\n resultado da multiplicação : " , resultado_da_multiplicacao)
  }

}
